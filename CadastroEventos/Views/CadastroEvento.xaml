<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.Views.CadastroEvento"
             Title="CadastroEvento"
             Shell.NavBarIsVisible="False">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="10" Spacing="25">

        <VerticalStackLayout>
            <Label 
            Text="NOME DO EVENTO"
            TextColor="Orange"
            FontAttributes="Bold"
            HorizontalOptions="CenterAndExpand"/>
            <Entry x:Name="nome_evento" Placeholder="Ex: Exame Presencial"/>
        </VerticalStackLayout>

        <VerticalStackLayout>
    <Label 
            Text="DATA DE INÍCIO"
            TextColor="Orange"
            FontAttributes="Bold"
            HorizontalOptions="CenterAndExpand"/>
            <DatePicker x:Name="dt_inicio" HorizontalOptions="CenterAndExpand"/>
            </VerticalStackLayout>

        <VerticalStackLayout>
        <Label 
            Text="DATA DE TÉRMINO"
            TextColor="Orange"
            FontAttributes="Bold"
            HorizontalOptions="CenterAndExpand"/>
            <DatePicker x:Name="dt_termino" HorizontalOptions="CenterAndExpand"/>
        </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label 
            Text="NÚMERO DE PARTICIPANTES"
            TextColor="Orange"
            FontAttributes="Bold"
            HorizontalOptions="CenterAndExpand"/>
        <Entry x:Name="n_participantes" Placeholder="Ex: 7" Keyboard="Numeric"/>
                </VerticalStackLayout>

        <VerticalStackLayout>
            <Label 
    Text="LOCAL DO EVENTO"
    TextColor="Orange"
    FontAttributes="Bold"
    HorizontalOptions="CenterAndExpand"/>
            <Entry x:Name="l_evento" Placeholder="Ex: Etec Getúlio Vargas"/>
        </VerticalStackLayout>

        <VerticalStackLayout>
            <Label 
    Text="CUSTO POR PARTICIPANTE"
    TextColor="Orange"
    FontAttributes="Bold"
    HorizontalOptions="CenterAndExpand"/>
            <Entry x:Name="c_participante" Placeholder="R$ 0" Keyboard="Numeric" />
        </VerticalStackLayout>
        
    </VerticalStackLayout>
</ContentPage>