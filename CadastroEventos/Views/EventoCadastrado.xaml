<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CadastroEventos.Views.EventoCadastrado"
             Title="EventoCadastrado"
             Shell.NavBarIsVisible="False">
    
    <VerticalStackLayout VerticalOptions="CenterAndExpand" Padding="10" Spacing="25">
        
        <Label 
            Text="{Binding Nome}"
            FontSize="Title"
            TextColor="Orange"
            FontAttributes="Bold"
            TextTransform="Uppercase"
            HorizontalOptions="Center"/>
        
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
        <Label 
    Text="início: "
    TextColor="Orange"
    FontAttributes="Bold"
    TextTransform="Uppercase"    />
            <Label Text= "{Binding DataInicio, StringFormat='{}{0:dd/MM/yyyy}'}"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
            <Label 
Text="término: "
TextColor="Orange"
FontAttributes="Bold"
TextTransform="Uppercase"    />
            <Label Text= "{Binding DataTermino, StringFormat='{}{0:dd/MM/yyyy}'}"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
            <Label 
Text="Duração:"
TextColor="Orange"
FontAttributes="Bold"
TextTransform="Uppercase"    />
            <Label Text="{Binding Duracao.Days}"/>
            <Label Text="Dias"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
            <Label 
Text="Participantes:"
TextColor="Orange"
FontAttributes="Bold"
TextTransform="Uppercase"    />
            <Label Text="{Binding NumeroParticipantes}"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
            <Label 
Text="Local:"
TextColor="Orange"
FontAttributes="Bold"
TextTransform="Uppercase"    />
            <Label Text="{Binding Local}"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
            <Label 
Text="Custo por participante:"
TextColor="Orange"
FontAttributes="Bold"
TextTransform="Uppercase"    />
        <Label Text="{Binding Custo, StringFormat='{}{0:c}'}"/>
        </HorizontalStackLayout>

        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
            <Label 
Text="Custo total:"
TextColor="Orange"
FontAttributes="Bold"
TextTransform="Uppercase"    />
        <Label Text="{Binding CustoTotal, StringFormat='{}{0:c}'}"/>
        </HorizontalStackLayout>

    </VerticalStackLayout>
</ContentPage>